includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    excludePaths:
        - app/Http/Controllers/Settings/*
        - app/Http/Requests/Settings/*
        - app/Http/Middleware/HandleInertiaRequests.php

    level: 7
